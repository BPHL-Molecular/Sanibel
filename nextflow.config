
// Default parameter values
params {
    bmgap2_db  = "/blue/bphl-florida/share/bmgap2"
    kraken_db  = "/blue/bphl-florida/share/kraken2_databases/k2_standard_8GB_20260226"
}

// Process-specific configs  
process {
    withName: fastqc {
        container = 'docker://staphb/fastqc:0.12.1'
        cpus      = 2
        memory    = '4 GB'
    }
    withName: trimmomatic {
        container = 'docker://staphb/trimmomatic:0.40'
        cpus      = 4
        memory    = '8 GB'
    }
    withName: bbtools_adapters {
        container = 'docker://staphb/bbtools:39.34'
        cpus      = 4
        memory    = '8 GB'
    }
    withName: bbtools_phix {
        container = 'docker://staphb/bbtools:39.34'
        cpus      = 4
        memory    = '8 GB'
    }
    withName: fastqc2 {
        container = 'docker://staphb/fastqc:0.12.1'
        cpus      = 2
        memory    = '4 GB'
    }
    withName: multiqc {
        container = 'docker://staphb/multiqc:1.33'
        cpus      = 2
        memory    = '4 GB'
    }
    withName: mash {
        container = 'docker://staphb/mash:2.3'
        cpus      = 4
        memory    = '8 GB'
    }
    withName: unicycler {
        container = 'docker://staphb/unicycler:0.5.1'
        cpus      = 10
        memory    = '32 GB'
    }
    withName: kraken {
        container = 'docker://staphb/kraken2:2.17.1'
        cpus      = 8
        memory    = '16 GB'
    }
    withName: quast {
        container = 'docker://staphb/quast:5.3.0'
        cpus      = 2
        memory    = '4 GB'
    }
    withName: parse_assembly {
        cpus   = 1
        memory = '2 GB'
    }
    withName: readssum {
        container = 'docker://staphb/lyveset:2.0.1'
        cpus      = 2
        memory    = '4 GB'
    }
    withName: parse_reads {
        cpus   = 1
        memory = '2 GB'
    }
    withName: prokka {
        container = 'docker://staphb/prokka:1.15.6'
        cpus      = 4
        memory    = '8 GB'
    }
    withName: amrfinder {
        container = 'docker://staphb/ncbi-amrfinderplus:4.2.7-2026-03-24.1'
        cpus      = 4
        memory    = '8 GB'
    }
    withName: mlst {
        container = 'docker://staphb/mlst:2.32.2'
        cpus      = 2
        memory    = '4 GB'
    }
    withName: pmga {
        container     = 'docker://staphb/pmga:3.0.2'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: parse_typing {
        cpus   = 1
        memory = '2 GB'
    }
    withName: bmgap2_amr {
        cpus   = 2
        memory = '2 GB'
    }
    withName: bmgap2_locusextractor {
        cpus   = 2
        memory = '4 GB'
    }
    withName: bmgap2_bmscan {
        cpus   = 2
        memory = '2 GB'
    }
    withName: legsta {
        container     = 'docker://staphb/legsta:0.5.1'
        cpus          = 2
        memory        = '4 GB'
        errorStrategy = 'ignore'
    }
    withName: kleborate {
        container     = 'docker://staphb/kleborate:3.2.4'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: shigatyper {
        container     = 'docker://staphb/shigatyper:2.0.5'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: emm_typing {
        container     = 'docker://staphb/emm-typing-tool:0.0.1'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: seqsero2 {
        container     = 'docker://staphb/seqsero2:1.3.2'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: serotypefinder {
        container     = 'docker://staphb/serotypefinder:2.0.2'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: plasmidfinder {
        container     = 'docker://staphb/plasmidfinder:3.0.3'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: seroba {
        container     = 'docker://staphb/seroba:2.0.5'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: pasty {
        container     = 'docker://staphb/pasty:2.2.1'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: kaptive_ab {
        container     = 'docker://staphb/kaptive:3.2.0'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: kaptive_vp {
        container     = 'docker://staphb/kaptive:3.2.0'
        cpus          = 4
        memory        = '8 GB'
        errorStrategy = 'ignore'
    }
    withName: generate_row {
        cpus   = 1
        memory = '2 GB'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process.container = null
    }

    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
        process.container = null
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        process.container = null
    }
}
// Global error handling
process.errorStrategy = 'finish'
process.maxRetries    = 0