// Default parameter values
params {
    bmgap2_db       = "/blue/bphl-florida/share/bmgap2"
    kraken_db       = "/blue/bphl-florida/share/kraken2_databases/minikraken2_v1_8GB_201904"
    blast16s_db_dir = "${launchDir}/db/16s_blastdb"

    // RefSeq genomes to fetch per candidate species for skani ANI confirmation.
    refseq_refs_per_candidate = 5

    // Minimum skani ANI to route species-specific analyses
    skani_routing_min_ani = 95
}

// Process-specific configs  
process {
    // Shared defaults; per-process blocks below override only where they differ.
    cpus   = 4
    memory = 8.GB

    withName: fastqc {
        container = 'docker://staphb/fastqc:0.12.1'
        cpus      = 2
        memory    = 4.GB
    }
    withName: trimmomatic {
        container = 'docker://staphb/trimmomatic:0.40'
    }
    withName: bbtools_adapters {
        container = 'docker://staphb/bbtools:39.34'
    }
    withName: bbtools_phix {
        container = 'docker://staphb/bbtools:39.34'
    }
    withName: fastqc2 {
        container = 'docker://staphb/fastqc:0.12.1'
        cpus      = 2
        memory    = 4.GB
    }
    withName: multiqc {
        container = 'docker://staphb/multiqc:1.33'
        cpus      = 2
        memory    = 4.GB
    }
    withName: mash {
        container = 'docker://staphb/mash:2.3-RefSeqProkv235'
    }
    withName: unicycler {
        container = 'docker://staphb/unicycler:0.5.1'
        cpus      = 10
        memory    = 32.GB
    }
    withName: kraken {
        container = 'docker://staphb/kraken2:2.17.1'
        cpus      = 8
        memory    = 16.GB
    }
    withName: quast {
        container = 'docker://staphb/quast:5.3.0'
        cpus      = 2
        memory    = 4.GB
    }
    withName: parse_assembly {
        cpus   = 1
        memory = 2.GB
    }
    withName: readssum {
        container = 'docker://staphb/lyveset:2.0.1'
        cpus      = 2
        memory    = 4.GB
    }
    withName: prokka {
        container = 'docker://staphb/prokka:1.15.6'
    }
    withName: amrfinder {
        container = 'docker://staphb/ncbi-amrfinderplus:4.2.7-2026-03-24.1'
    }
    withName: mlst {
        container = 'docker://staphb/mlst:2.32.2'
        cpus      = 2
        memory    = 4.GB
    }
    withName: pmga {
        container     = 'docker://staphb/pmga:3.0.2'
        errorStrategy = 'ignore'
    }
    withName: download_16s_db {
        container = 'docker://staphb/blast:2.17.0'
        cpus      = 2
        memory    = 4.GB
    }
    withName: blast_16s {
        container = 'docker://staphb/blast:2.17.0'
    }
    withName: aggregate_species_id {
        cpus   = 1
        memory = 2.GB
    }
    withName: build_candidates {
        cpus   = 1
        memory = 2.GB
    }
    withName: candidate_references {
        container     = 'docker://staphb/ncbi-datasets:18.9.0'
        cpus          = 2
        memory        = 4.GB
        maxForks      = 4
        errorStrategy = 'ignore'
    }
    withName: skani {
        container = 'docker://staphb/skani:0.3.1'
    }
    // The three host-run BMGAP2 steps share cache/error/cpus/memory; only
    // LocusExtractor needs more memory.
    withName: 'bmgap2_.*' {
        cache         = false
        memory        = 4.GB
        errorStrategy = 'ignore'
    }
    withName: bmgap2_locusextractor {
        memory = 8.GB
    }
    withName: legsta {
        container     = 'docker://staphb/legsta:0.5.1'
        cpus          = 2
        memory        = 4.GB
        errorStrategy = 'ignore'
    }
    withName: kleborate {
        container     = 'docker://staphb/kleborate:3.2.4'
        errorStrategy = 'ignore'
    }
    withName: shigatyper {
        container     = 'docker://staphb/shigatyper:2.0.5'
        errorStrategy = 'ignore'
    }
    withName: emm_typing {
        container     = 'docker://staphb/emm-typing-tool:0.0.1'
        errorStrategy = 'ignore'
    }
    withName: seqsero2 {
        container     = 'docker://staphb/seqsero2:1.3.2'
        errorStrategy = 'ignore'
    }
    withName: serotypefinder {
        container     = 'docker://staphb/serotypefinder:2.0.2'
        errorStrategy = 'ignore'
    }
    withName: plasmidfinder {
        container     = 'docker://staphb/plasmidfinder:3.0.3'
        errorStrategy = 'ignore'
    }
    withName: seroba {
        container     = 'docker://staphb/seroba:2.0.5'
        errorStrategy = 'ignore'
    }
    withName: pasty {
        container     = 'docker://staphb/pasty:2.2.1'
        errorStrategy = 'ignore'
    }
    withName: kaptive_ab {
        container     = 'docker://staphb/kaptive:3.2.0'
        errorStrategy = 'ignore'
    }
    withName: kaptive_vp {
        container     = 'docker://staphb/kaptive:3.2.0'
        errorStrategy = 'ignore'
    }
    withName: lissero {
        container     = 'docker://quay.io/biocontainers/lissero:0.4.10--pyhdfd78af_0'
        cpus          = 2
        memory        = 4.GB
        errorStrategy = 'ignore'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process.container = null
    }

    singularity {
        singularity {
            enabled = true
            autoMounts = true
        }
        process.container = null
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
        }
        process.container = null
    }
}
// Global error handling
process.errorStrategy = 'finish'
process.maxRetries    = 0